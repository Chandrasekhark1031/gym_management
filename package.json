{
  "name": "gym-management-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready monorepo for Gym Management System",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "node scripts/build.mjs",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "dev:sites": "node scripts/dev.mjs --sites",
    "build:sites": "node scripts/build-sites.mjs",
    "db:generate": "drizzle-kit generate",
    "test:sites": "node --test apps/sites-api/tests/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4"
  }
}
